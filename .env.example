# GST ARCHANGEL - Environment Configuration (template)
# Copy to .env and fill in real values. Never commit real secrets.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gst_archangel
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
ENV=development
DEMO_MODE=false

GST_MODELS_DIR=models
GST_DATASETS_DIR=datasets

MATCH_CONFIDENCE_THRESHOLD=80
MATCH_AMOUNT_TOLERANCE_PCT=0.01
MATCH_DATE_WINDOW_DAYS=5

RISK_MAX_SCORE=100
RISK_GST_RATE=0.18
RISK_AMOUNT_MISMATCH_TOL=0.01
